# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. With Vercel Postgres, use the pooled
# connection string from your project's Storage tab (Neon-backed; the
# pooled variant has "-pooler" in the hostname).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Signs and verifies session cookies. Generate with: openssl rand -base64 32
# Do NOT reuse the value from any example, README, or other project.
JWT_SECRET=

# Vercel Blob store token, for OCR bill-image uploads.
# Created automatically when you add a Blob store to your Vercel project
# (Storage tab) and pull env vars with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key, for the AI bill scanner (OCR). Get one at
# https://console.anthropic.com — optional: the app runs fine without it,
# the Bill Scanner page just shows a "not configured" state.
ANTHROPIC_API_KEY=
