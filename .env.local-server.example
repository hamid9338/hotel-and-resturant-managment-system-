# Env file for the ON-SITE LOCAL SERVER (see DEPLOYMENT-LOCAL.md) — a second
# deployment of this same app, running on a machine at the restaurant's own
# LAN, independent of internet access. Copy to .env on that machine and fill
# in real values. Never commit the real .env. This is NOT what you use for
# normal development against the cloud DB — see .env.example for that.

# Local Postgres, started via `docker compose up -d` (docker-compose.yml at
# the repo root) or a native install — see DEPLOYMENT-LOCAL.md for both paths.
# Must be bootstrapped from a pg_dump/restore of the live cloud database, NOT
# a fresh `npm run db:seed` — see DEPLOYMENT-LOCAL.md for why (mismatched
# UUIDs on rooms/menu items/etc. would break every operation forwarded to the
# cloud in Phase 2).
DATABASE_URL="postgresql://kvl:changeme_local_only@localhost:5432/kvl_local"

# MUST be the exact same value as the cloud deployment's JWT_SECRET (copy it
# from Vercel's env vars) — the local→cloud sync worker mints its own session
# tokens and they need to verify against the cloud database too.
JWT_SECRET=

# Tells the app it's running as the on-site LAN server: plain HTTP on a bare
# local IP, no TLS cert. Without this, session cookies silently fail to
# persist in the browser and login looks like it works once, then immediately
# looks logged-out on every next request. Always "true" for this deployment.
LOCAL_LAN_DEPLOYMENT=true

# The cloud deployment's URL, so the local→cloud sync worker
# (scripts/cloud-sync-worker.ts) knows where to push queued operations once
# internet is available. Leave unset to run Phase 1 only (local resilience,
# no cloud mirroring) — the worker script simply won't run without this.
CLOUD_SYNC_TARGET_URL="https://your-deployment.vercel.app"

# Optional — reuse the same values as production if you want these features
# to keep working locally whenever the LAN happens to have internet. All
# three already degrade gracefully to a "not configured" state when unset,
# so it's equally fine to leave them out entirely.
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
